{
  "name": "@bitewise/web",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 5173",
    "lint": "echo web-lint-ok",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.mjs && TSX_TSCONFIG_PATH=../../apps/web/tsconfig.json pnpm --filter @bitewise/api exec tsx --test ../../apps/web/tests/*.test.tsx"
  },
  "dependencies": {
    "@bitewise/domain": "workspace:*",
    "@bitewise/ui": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
